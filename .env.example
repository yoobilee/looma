# 서버 함수(api/)만 읽는 값이다. VITE_ 접두사를 붙이지 않는다 — 붙이면 브라우저 번들에 들어간다.
# 실제 값은 Vercel 프로젝트의 Environment Variables에 등록하고 이 파일이나 Git에 적지 않는다.

# Groq API 키 (https://console.groq.com/keys)
GROQ_API_KEY=

# AI 함수 접근 코드. 24자 이상의 무작위 값. 비어 있거나 짧으면 AI 함수는 모든 요청을 거부한다.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LOOMA_AI_ACCESS_CODE=
